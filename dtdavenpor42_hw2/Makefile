# Compiler and linker
CC      = aarch64-linux-gnu-gcc
LD      = aarch64-linux-gnu-ld

CFLAGS  = -g -pedantic -Wall -Wextra -fPIC -std=gnu2x -MMD -fno-builtin-strlen
ASFLAGS = -g -MMD
LDFLAGS = -g -N -Ttext=0x10000

# Object files
OBJ     = boot.o kernel.o progress.o process_asm.o init.o pcb.o stack.o queue.o process.o helper.o
DEPS    = $(OBJ:.o=.d)

.PHONY: all clean run debug

all: kernel.elf

# --- Link final kernel image ---
kernel.elf: libos.a $(OBJ)
	$(LD) $(LDFLAGS) -o kernel.elf $(OBJ) libos.a

# --- C source file rules ---
kernel.o: kernel.c
	$(CC) $(CFLAGS) -c kernel.c -o kernel.o

init.o: init.c
	$(CC) $(CFLAGS) -c init.c -o init.o

pcb.o: pcb.c
	$(CC) $(CFLAGS) -c pcb.c -o pcb.o

stack.o: stack.c
	$(CC) $(CFLAGS) -c stack.c -o stack.o

queue.o: queue.c
	$(CC) $(CFLAGS) -c queue.c -o queue.o

process.o: process.c
	$(CC) $(CFLAGS) -c process.c -o process.o

helper.o: helper.c
	$(CC) $(CFLAGS) -c helper.c -o helper.o

# --- Assembly file rules ---
boot.o: boot.S
	$(CC) $(ASFLAGS) -c boot.S -o boot.o

progress.o: progress.S
	$(CC) $(ASFLAGS) -c progress.S -o progress.o

process_asm.o: process_asm.S
	$(CC) $(ASFLAGS) -c process_asm.S -o process_asm.o

# --- Run OS in QEMU ---
run:
	qemu-system-aarch64 -machine raspi3b -kernel kernel.elf

# --- Debug OS in QEMU with GDB stub ---
debug:
	qemu-system-aarch64 -machine raspi3b -S -s -kernel kernel.elf &
	ddd --debugger 'gdb-multiarch -ex "target remote localhost:1234" -ex "break main" -ex "continue"' kernel.elf

# --- Cleanup ---
clean:
	rm -f $(OBJ) $(DEPS) kernel.elf

# Include dependency files generated by -MMD
-include $(DEPS)